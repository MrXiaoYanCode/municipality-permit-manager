# Supabase

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key



# Stripe

STRIPE_SECRET_KEY=sk_test_...

STRIPE_WEBHOOK_SECRET=whsec_...

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...



# Stripe Price IDs (create in Stripe Dashboard)

STRIPE_PRICE_STARTER=price_...

STRIPE_PRICE_PROFESSIONAL=price_...

STRIPE_PRICE_ENTERPRISE=price_...



# Usage-based billing meter (auto-created by scripts/stripe-provision.mjs)

STRIPE_METER_ID=mtr_...



# AI Providers (priority: Gemini → OpenRouter → OpenAI)

# Gemini free tier: https://aistudio.google.com/apikey
# Models: gemini-3.1-flash-lite → 3.5-flash-lite → 3.6-flash (2.5 retires Oct 16, 2026)

GEMINI_API_KEY=AIza...



# OpenRouter free models: https://openrouter.ai/keys
# Fallback models: llama-3.3-70b, qwen3-next-80b, deepseek-r1, openrouter/free
# Tip: $10 lifetime credits raises free limit from 50 to 1,000 requests/day
OPENROUTER_API_KEY=sk-or-...



# Optional paid fallback

OPENAI_API_KEY=sk-...

AI_PROVIDER_API_KEY=sk-...



# App

NEXT_PUBLIC_APP_URL=http://localhost:3000

